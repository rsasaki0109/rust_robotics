+// The archived probe reads only position and yaw. All other policy inputs stay raw.
+fn mean_speed_probe_pose(
+    sensed: VehicleState,
+    enabled: bool,
+    paused: bool,
+    age: f64,
+    count: usize,
+    mean_x: f64,
+    mean_y: f64,
+) -> (VehicleState, bool) {
+    let used = enabled && paused && sensed.v.abs() <= 0.02 && age <= 1.5 && count >= 10;
+    if used {
+        (VehicleState::new(mean_x, mean_y, sensed.yaw, sensed.v, sensed.wheelbase), true)
+    } else {
+        (sensed, false)
+    }
+}
+
+#[cfg(test)]
+mod mean_speed_probe_tests {
+    use super::*;
+    fn state(speed: f64) -> VehicleState { VehicleState::new(10.0, 10.0, 0.7, speed, 0.4) }
+    #[test]
+    fn disabled_is_exact_raw_fallback() {
+        let (p, used) = mean_speed_probe_pose(state(0.0), false, true, 0.0, 25, 20.0, 21.0);
+        assert!(!used); assert_eq!((p.x, p.y, p.yaw, p.v), (10.0, 10.0, 0.7, 0.0));
+    }
+    #[test]
+    fn thresholds_are_inclusive_and_heading_speed_unchanged() {
+        for speed in [0.02, -0.02] {
+            let (p, used) = mean_speed_probe_pose(state(speed), true, true, 1.5, 10, 20.0, 21.0);
+            assert!(used); assert_eq!((p.x, p.y, p.yaw, p.v), (20.0, 21.0, 0.7, speed));
+        }
+    }
+    #[test]
+    fn insufficient_samples_and_unpaused_keep_raw_pose() {
+        for (paused, count) in [(true, 9), (false, 25)] {
+            let (p, used) = mean_speed_probe_pose(state(0.0), true, paused, 0.0, count, 20.0, 21.0);
+            assert!(!used); assert_eq!((p.x, p.y), (10.0, 10.0));
+        }
+    }
+    #[test]
+    fn first_float_above_speed_and_age_thresholds_falls_back() {
+        let speed = f64::from_bits(0.02_f64.to_bits() + 1);
+        let age = f64::from_bits(1.5_f64.to_bits() + 1);
+        assert!(!mean_speed_probe_pose(state(speed), true, true, 0.0, 25, 20.0, 21.0).1);
+        assert!(!mean_speed_probe_pose(state(-speed), true, true, 0.0, 25, 20.0, 21.0).1);
+        assert!(!mean_speed_probe_pose(state(0.0), true, true, age, 25, 20.0, 21.0).1);
+    }
+    #[test]
+    fn selected_position_reaches_the_original_full_probe() {
+        let raw = VehicleState::new(10.0, 10.0, 0.0, 0.0, 0.4);
+        let obs = [Point2D::new(10.4, 10.0)];
+        let (p, used) = mean_speed_probe_pose(raw, true, true, 0.0, 10, 12.0, 10.0);
+        assert!(used);
+        assert_eq!(speed_free_distance(raw, 0.0, 0.5, &obs), 0.0);
+        assert_eq!(speed_free_distance(p, 0.0, 0.5, &obs), 2.0);
+    }
+}
+
+// Only the guard-preview position changes; every other state field is preserved.
+fn mean_guard_preview_pose(
+    mut preview: VehicleState, enabled: bool, joint_pending: bool,
+    mean_speed_probe_used: bool, mean_x: f64, mean_y: f64,
+) -> (VehicleState, bool) {
+    let used = enabled && joint_pending && mean_speed_probe_used;
+    if used { preview.x = mean_x; preview.y = mean_y; }
+    (preview, used)
+}
+
+#[cfg(test)]
+mod mean_guard_preview_tests {
+    use super::*;
+    #[test]
+    fn every_ineligible_flag_combination_preserves_all_fields() {
+        for enabled in [false, true] { for pending in [false, true] { for speed_used in [false, true] {
+            let raw = VehicleState::new(10.0, 11.0, 0.7, -0.02, 0.4);
+            let (pose, used) = mean_guard_preview_pose(raw, enabled, pending, speed_used, 20.0, 21.0);
+            assert_eq!(used, enabled && pending && speed_used);
+            if !used { assert_eq!((pose.x, pose.y), (raw.x, raw.y)); }
+            assert_eq!((pose.yaw, pose.v, pose.wheelbase, pose.rear_x, pose.rear_y),
+                (raw.yaw, raw.v, raw.wheelbase, raw.rear_x, raw.rear_y));
+        } } }
+    }
+    #[test]
+    fn active_changes_only_position_including_zero_speed() {
+        for speed in [0.0, 0.02, -0.02] {
+            let raw = VehicleState::new(10.0, 11.0, 0.7, speed, 0.4);
+            let (pose, used) = mean_guard_preview_pose(raw, true, true, true, 20.0, 21.0);
+            assert!(used); assert_eq!((pose.x, pose.y), (20.0, 21.0));
+            assert_eq!((pose.yaw, pose.v, pose.wheelbase, pose.rear_x, pose.rear_y),
+                (raw.yaw, raw.v, raw.wheelbase, raw.rear_x, raw.rear_y));
+        }
+    }
+    #[test]
+    fn selected_position_reaches_original_stopping_and_terminal_geometry() {
+        let raw = VehicleState::new(10.0, 10.0, 0.0, 0.0, 0.4);
+        let obs = [Point2D::new(10.4, 10.0)];
+        let (pose, _) = mean_guard_preview_pose(raw, true, true, true, 12.0, 10.0);
+        for target in [0.0, 0.2] {
+            let a = stopping_preview(raw, target, 0.0, 0.5, &obs, true, true);
+            let b = stopping_preview(pose, target, 0.0, 0.5, &obs, true, true);
+            assert_ne!(a, b); assert!(a.0 < b.0); assert!(a.1 < b.1);
+        }
+    }
+}
